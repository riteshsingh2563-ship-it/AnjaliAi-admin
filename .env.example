# =============================================================================
# ANJALI AI Admin Dashboard — Environment Variables Template
# Copy this file to `.env.local` for local development or add these variable
# names in your Vercel Project Settings -> Environment Variables.
# NEVER commit real secrets or service account keys to Git.
# =============================================================================

# 1. Neon PostgreSQL Database (Required for Drizzle ORM: admin_allowlist, configs, audit_logs, usage_logs)
DATABASE_URL=

# 2. Admin Authentication & Authorization (Required)
# Long random secret string (32+ chars) used to sign HTTP-only admin session cookies
ADMIN_SESSION_SECRET=
# Comma-separated list of authorized admin Google emails seeded into `admin_allowlist`
ADMIN_EMAILS=

# 3. Firebase Web SDK Configuration (Public — used for Google Sign-In on /login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gen-lang-client-0553500643
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_APP_URL=https://anjalia.vercel.app

# 4. Firebase Admin SDK & Firestore Configuration (Server-only — NEVER prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=gen-lang-client-0553500643
FIREBASE_DATABASE_ID=ai-studio-android-anjaliai-af35263e-02d3-4218-b283-00d5976cfc2d
# Option A: Raw JSON string or base64-encoded JSON string of your Firebase Service Account key
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Or provide client email and private key separately if preferred
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 5. NVIDIA AI Provider Configuration (Server-only — used by /api/ai/chat)
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=google/gemma-4-31b-it

# 6. Optional AI Usage Ingestion Shared Secret (Server-only — for server-to-server POST /api/usage/ingest)
# Note: Authenticated Android app requests also work automatically via Firebase ID tokens.
USAGE_INGEST_API_KEY=
