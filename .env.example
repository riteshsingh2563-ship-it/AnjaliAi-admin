# =============================================================================
# ANJALI AI Admin Dashboard — Environment Variables Template
# Copy this file to `.env.local` for local development or add these variable
# names in your Vercel Project Settings -> Environment Variables.
# NEVER commit real secrets or service account keys to Git.
# =============================================================================

# 1. PostgreSQL Database (Required for Drizzle ORM: admin_allowlist, configs, audit_logs, usage_logs)
DATABASE_URL=

# 2. Admin Authentication & Authorization (Required)
# Long random secret string (32+ chars) used to sign HTTP-only admin session cookies
ADMIN_SESSION_SECRET=
# Comma-separated list of authorized admin Google emails seeded into `admin_allowlist` on first login
ADMIN_EMAILS=

# 3. Firebase Client SDK Configuration (Public — used for Google Sign-In on /login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# 4. Firebase Admin SDK & Firestore Configuration (Server-only — NEVER expose with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
# Raw JSON string or base64-encoded JSON string of your Firebase Service Account key
FIREBASE_SERVICE_ACCOUNT_KEY=

# 5. Optional AI Usage Ingestion Shared Secret (Server-only — for POST /api/usage/ingest)
USAGE_INGEST_API_KEY=

# 6. NVIDIA AI Integration (Server-only — keeps NVIDIA API key safe from mobile clients)
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
